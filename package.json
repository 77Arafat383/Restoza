{
  "name": "restoza-platform",
  "version": "1.0.0",
  "description": "Restoza - Modern Restaurant Management & Operations Platform",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgMagenta.bold,bgCyan.bold\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "seed": "npm --prefix server run prisma:seed",
    "db:push": "npm --prefix server run prisma:push",
    "build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
